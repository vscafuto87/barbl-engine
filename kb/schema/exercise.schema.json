{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://barbl/kb/exercise.schema.json",
  "title": "Esercizio",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "equipment",
    "requires",
    "pattern",
    "mechanics",
    "muscles",
    "loading",
    "substitutes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "name": {
      "type": "object",
      "required": [
        "it",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "it": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "equipment": {
      "type": "string"
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pattern": {
      "type": "string"
    },
    "mechanics": {
      "enum": [
        "compound",
        "isolation"
      ]
    },
    "muscles": {
      "type": "object",
      "required": [
        "primary",
        "secondary"
      ],
      "additionalProperties": false,
      "properties": {
        "primary": {
          "type": "string"
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "loading": {
      "type": "object",
      "required": [
        "whenLoadUnknown"
      ],
      "additionalProperties": false,
      "properties": {
        "stepKg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "whenLoadUnknown": {
          "enum": [
            "trial_set",
            "manual"
          ]
        }
      }
    },
    "substitutes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array"
    },
    "technique": {
      "description": "Scheda tecnica: setup, cue ed errori comuni, scritti con parole nostre, con fonte.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setup",
        "cues",
        "mistakes",
        "sources",
        "status",
        "reviewedBy"
      ],
      "properties": {
        "setup": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "it",
              "en"
            ],
            "additionalProperties": false,
            "properties": {
              "it": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            }
          }
        },
        "cues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "it",
              "en"
            ],
            "additionalProperties": false,
            "properties": {
              "it": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            }
          }
        },
        "mistakes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "what",
              "fix"
            ],
            "additionalProperties": false,
            "properties": {
              "what": {
                "type": "object",
                "required": [
                  "it",
                  "en"
                ],
                "additionalProperties": false,
                "properties": {
                  "it": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "en": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                }
              },
              "fix": {
                "type": "object",
                "required": [
                  "it",
                  "en"
                ],
                "additionalProperties": false,
                "properties": {
                  "it": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "en": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                }
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "access"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "pages": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "access": {
                "enum": [
                  "full_text",
                  "full_text_preprint",
                  "abstract_only",
                  "summary"
                ]
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "status": {
          "enum": [
            "provisional",
            "confirmed"
          ]
        },
        "reviewedBy": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "technicalDemand": {
      "description": "high: esercizio tecnicamente impegnativo; chi comincia (under_6_months) lo riceve solo se l'attrezzatura non offre altro (P-BEGINNER-SIMPLER).",
      "enum": [
        "high"
      ]
    }
  }
}
